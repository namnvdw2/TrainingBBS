{% _layout 'layout.liquid' %}

{% _area title %}ログイン画面{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<vue-login></vue-login>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-login">
  <div class="container">
    <div class="d-flex justify-content-center align-items-center vh-100">
      <div class="justify-content-center">
        <h4 class="text-center fw-bold mb-4">掲示板</h4>
        <form class="align-items-center" @submit.prevent="login" novalidate>
          <div class="mb-3">
            <input :class="['form-control', { 'is-invalid': errors.LoginId  }]" type="text" v-model="loginId" placeholder="ログインID" />
            <div class="invalid-feedback">${ errors.LoginId }</div>
          </div>
          <div class="mb-3">
            <input class="form-control" type="password" v-model="password" placeholder="パスワード" />
          </div>
          <div class="text-center mb-3 text-danger" v-if="errorMessage">
            ${ errorMessage }
          </div>
          <div class="mb-3 d-flex justify-content-center">
            <button type="submit" class="btn btn-primary w-20">ログイン</button>
          </div>
        </form>
        <p class="text-center">
          アカウントを持っていない方は
          <a class="" href="{{ RootUrl | append: "user/register/input" }}">アカウントを作成する</a>
        </p>
      </div>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-login', {
    template: '#vue-login',
    data() {
      return {
        loginId: '',
        password: '',
        errors: {},
        errorMessage: '',
      }
    },
    mounted() {
    },
    methods: {
      login: function () {
        this.errors = {};
        this.errorMessage = '';
        const options = {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ loginId: this.loginId, password: this.password }),
        }

        const promise = fetch(window.apiRoot + '/login', options)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            return response.json();
          })
          .then(result => {
            if (result.Success) {
              window.location.href = result.RedirectUrl;
              return;
            }

            this.errors = result.Errors || {};
            this.errorMessage = result.Message || '';
          })
          .catch(error => {
            console.error('Error during login:', error);
            this.errorMessage = 'エラーが発生しました。時間をおいて再度お試しください。';
          });
      }
    }
  });
  {% end_javascript %}
</script>
