{% _layout 'layout.liquid' %}

{% _area title %}トップページ{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<h1>{{ Message }}</h1>
<vue-index></vue-index>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-index">
  <h1 class="text-center">${ message }</h1>
  <div>
    <img class="d-block mx-auto" src="http://localhost/Training.BBS/Web/w2.BBS.Front/Images/404.webp"/>
    <p class="text-center" v-if="stateMessage">${ stateMessage }</p>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-index', {
    template: '#vue-index',
    data() {
      return {
        message: "404 roi",
        stateMessage: "404 ba la oi ba",
      }
    },
    mounted() {
      this.getMessage().then(msg => {
        this.message = msg.Message;
      })
    },
    methods: {
      getMessage: function () {
        return fetch(window.apiRoot + '/get-message').then(response => {
          if (!response.ok) {
            throw new Error(`HTTP ${res.status}`);
          }

          return response.json();
        });
      },
      updateMessage: function () {
        const options = {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ message: this.message }),
        }

        const promise = fetch(window.apiRoot + '/update-message', options)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${res.status}`);
            }

            this.stateMessage = 'DB更新完了!';

            return response.json();
          });
      }
    }
  });
  {% end_javascript %}
</script>
