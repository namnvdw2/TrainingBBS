{% _layout 'layout.liquid' %}

{% _area title %}ログイン画面{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<account-delete></account-delete>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="account-delete">
  <div class="container vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100 justify-content-center">
      <div class="col-md-5">
        <div class="text-center">
          <h1 class="fw-bold mb-5">アカウント削除</h1>
          <p class="fs-4 mb-5">
            このアカウントを削除しますか？
          </p>
          <div class="d-flex justify-content-center gap-3">
            <button class="btn btn-primary px-5 w-40" @click="cancel">
              キャンセル
            </button>
            <button class="btn btn-primary px-5 w-40" @click="deleteAccount">
              削除
            </button>
          </div>
          <div class="text-danger mt-4" v-if="errorMessage">
            ${ errorMessage }
          </div>
        </div>
      </div>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent("account-delete", {
    template: "#account-delete",
    data() {
      return {
        errorMessage: ""
      };
    },
    methods: {
      cancel() {
        history.back();
      },
      deleteAccount() {
        fetch(window.apiRoot + "account/delete", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          }
        })
          .then(r => r.json())
          .then(result => {
            if (result.Success) {
              window.location.href = result.RedirectUrl;
              return;
            }
            this.errorMessage = result.Message || "エラーが発生しました。";
          });
      }
    }
  });
  {% end_javascript %}
</script>
