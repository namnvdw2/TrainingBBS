{% _layout 'layout.liquid' %}

{% _area title %}登録内容確認{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<vue-confirm></vue-confirm>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-confirm">
  <div class="container">
    <div class="d-flex justify-content-center align-items-center vh-100">
      <div class="justify-content-center">
        <h4 class="text-center fw-bold mb-4">登録内容確認</h4>
        <form class="align-items-center">
          <div class="mb-1">
            <div class="text-center">ユーザー名 : ${ name }</div>
          </div>
          <div class="mb-1">
            <div class="text-center">ID : ${ loginId }</div>
          </div>
          <div class="mb-4">
            <div class="text-center">パスワード : ${ password }</div>
          </div>
          <div class="mb-3 d-flex justify-content-around">
            <button class="btn btn-primary w-20" @click="login()">登録</button>
            <button class="btn btn-primary w-20" @click="window.history.back()">戻る</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-confirm', {
    template: '#vue-confirm',
    data() {
      return {
        name: "{{ Name }}",
        loginId: "{{ LoginId }}",
        password: "{{ Password }}"
      }
    },
    mounted() {
    },
    methods: {
      login: function () {
        const options = {
          method: 'POST',
          headers: {
              'Content-Type': 'application/json',
          },
          body: JSON.stringify({
              loginId: this.loginId,
              password: this.password
            }),
        }

