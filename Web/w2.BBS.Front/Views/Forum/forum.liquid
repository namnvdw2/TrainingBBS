{% _layout 'layout.liquid' %}

{% _area title %}トップページ{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<div class="container">
  <forum-top-create></forum-top-create>
  <forum-top-list></forum-top-list>
</div>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="forum-top-create">
  <form @submit.prevent="postForum">
    <div class="d-flex justify-content-center align-items-center mt-5">
      <h2>投稿フォーム</h2>
      <button class="btn btn-primary w-5 mx-3 px-5" type="submit">投稿</button>
    </div>
    <div class="row mb-3 align-items-start">
      <label class="col-sm-3 col-form-label text-end">
        作成者 :
      </label>
      <label class="col-sm-9 col-form-label">
        {{ Name }}
      </label>
    </div>
    <div class="row mb-3 align-items-start">
      <label class="col-sm-3 col-form-label text-end">
        タイトル :
      </label>
      <div class="col-sm-9">
        <input :class="['form-control', { 'is-invalid': errors.title }]" type="text" v-model="title" placeholder="15字以内" />
        <div class="invalid-feedback">${ errors.title }</div>
      </div>
    </div>
    <div class="row mb-3 align-items-start">
      <label class="col-sm-3 col-form-label text-end">
        内容 :
      </label>
      <div class="col-sm-9">
        <textarea :class="['form-control', { 'is-invalid': errors.content }]" rows="5" v-model="content" placeholder="50字以内" />
        <div class="invalid-feedback">${ errors.content }</div>
      </div>
    </div>
  </form>
</script>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="forum-top-list">
  <div class="mt-5">
    <h3>投稿一覧</h3>

    <div v-if="loading">
      読み込み中...
    </div>

    <div v-else-if="forums.length === 0">
      投稿がありません。
    </div>

    <div v-else>
      <div v-if="errorMessage" class="text-danger text-end mt-2">
        ${ errorMessage }
      </div>
      <div class="py-3 border-bottom" v-for="(forum, index) in forums" :key="forum.ForumId">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <span class="fw-bold">
              #${ ((currentPage - 1) * pageSize + index + 1).toString().padStart(3, '0') }
            </span>
            <span class="ms-3">
              投稿者： <strong>${ forum.UserName }</strong>
            </span>
            <span class="ms-3">
              投稿日時： ${ forum.DateCreated }
            </span>
          </div>
        </div>
        <div class="mt-2">
          タイトル： <strong>${ forum.Title }</strong>
        </div>
        <div class="mt-1">
          本文： ${ forum.Text }
        </div>
        <div class="d-flex justify-content-end">
          <a href="#" class="me-2" @click.prevent="replyForum(forum)">レス</a>
          <template v-if="forum.IsOwner">
            <a href="#" class="me-2" @click.prevent="editForum(forum)">編集</a>
            <a href="#" @click.prevent="deleteForum(forum.ForumId)">削除</a>
          </template>
        </div>
        <div v-if="forum.Responses && forum.Responses.length" class="mt-3 ms-5">
          <div class="py-3 border-bottom"
               v-for="(response, responseIndex) in forum.Responses"
               :key="response.ForumResponseId">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <span class="fw-bold">
                  ↳ #${ responseIndex + 1 }
                </span>
                <span class="ms-3">
                  投稿者： <strong>${ response.UserName }</strong>
                </span>
                <span class="ms-3">
                  投稿日時： ${ response.DateCreated }
                </span>
              </div>
            </div>
            <div class="mt-2">タイトル： <strong>${ response.Title }</strong></div>
            <div class="mt-1">本文： ${ response.Text }</div>
          </div>
        </div>
        <div v-if="editingForumId === forum.ForumId" class="border rounded p-3 mt-3 bg-light">
          <div class="row mb-3">
            <label class="col-sm-2 text-end">
              編集タイトル：
            </label>
            <div class="col-sm-10">
              <input :class="['form-control', { 'is-invalid': editErrors.title }]" v-model="editTitle">
              <div class="invalid-feedback">${ editErrors.title }</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 text-end">
              編集本文：
            </label>
            <div class="col-sm-10">
              <textarea rows="5" :class="['form-control', { 'is-invalid': editErrors.content }]" v-model="editContent"></textarea>
              <div class="invalid-feedback">
                ${ editErrors.content }
              </div>
            </div>
          </div>
          <div class="text-end">
            <a href="#" class="me-3" @click.prevent="updateForum">更新</a>
            <a href="#" @click.prevent="cancelEdit">キャンセル</a>
          </div>
        </div>
        <div v-if="replyForumId === forum.ForumId" class="border rounded p-3 mt-3 bg-light">
          <div class="row mb-3 align-items-start">
            <label class="col-sm-2 text-end">
              レス作成者：
            </label>
            <div class="col-sm-10 pt-2">
              {{ Name }}
            </div>
          </div>

          <div class="row mb-3 align-items-start">
            <label class="col-sm-2 text-end">
              タイトル：
            </label>
            <div class="col-sm-10">
              <input :class="['form-control', { 'is-invalid': replyErrors.title }]" v-model="replyTitle" placeholder="15字以内">
              <div class="invalid-feedback">
                ${ replyErrors.title }
              </div>
            </div>
          </div>

          <div class="row mb-3 align-items-start">
            <label class="col-sm-2 text-end">
              本文：
            </label>
            <div class="col-sm-10">
              <textarea rows="5" :class="['form-control', { 'is-invalid': replyErrors.content }]" v-model="replyContent" placeholder="50字以内"></textarea>
              <div class="invalid-feedback">
                ${ replyErrors.content }
              </div>
            </div>
          </div>

          <div class="text-end">
            <a href="#" class="me-3" @click.prevent="postReply">投稿</a>
            <a href="#" @click.prevent="cancelReply">キャンセル</a>
          </div>
        </div>
      </div>
    </div>
    <nav v-if="totalPage>1">
      <ul class="pagination justify-content-center mt-5">
        <li :class="['page-item', { disabled: currentPage === 1 }]">
          <a href="#" class="page-link" @click.prevent="changePage(currentPage-1)"> Previous </a>
        </li>
        <li :class="['page-item', { active:page==currentPage }]" v-for="page in pages" :key="page" >
          <a href="#" class="page-link" @click.prevent="changePage(page)"> ${ page } </a>
        </li>
        <li :class="['page-item', { disabled: currentPage === totalPage }]">
          <a href="#" class="page-link" @click.prevent="changePage(currentPage+1)"> Next </a>
        </li>
      </ul>
    </nav>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('forum-top-create', {
    template: '#forum-top-create',
    data() {
      return {
        title: '',
        content: '',
        errors: {},
        errorMessage: '',
      }
    },
    mounted() {
    },
    methods: {
      postForum() {
        const options = {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            title: this.title,
            content: this.content
          })
        };
        fetch(window.apiRoot + 'forum/post-forum', options)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            return response.json();
          })
          .then(result => {
            if (result.Success) {
              window.location.href = result.RedirectUrl;
              return;
            }

            this.errors = result.Errors || {};
            this.errorMessage = result.Message || '';
          })
          .catch(error => {
            this.errorMessage = 'エラーが発生しました。';
          });
      }
    }
  });
  g_vueManager.setComponent("forum-top-list", {
    template: "#forum-top-list",
    data() {
      return {
        forums: [],
        currentPage: 1,
        pageSize: 10,
        totalPage: 0,
        totalCount: 0,
        loading: false,

        editingForumId: null,
        editTitle: "",
        editContent: "",
        editErrors: {},

        replyForumId: null,
        replyTitle: "",
        replyContent: "",
        replyErrors: {},

        errorMessage: "",
      };
    },
    computed: {
      pages() {
        const pages = [];
        let start = Math.max(1, this.currentPage - 2);
        let end = Math.min(this.totalPage, start + 4);
        if (end - start < 4) start = Math.max(1, end - 4);

        for (let i = start; i <= end; i++) {
          pages.push(i);
        }

        return pages;
      }
    },
    mounted() {
      const page = this.getPageFromUrl();
      this.loadForums(page);
      window.addEventListener("forum-created", () => {
        this.loadForums(1);
      });
      window.addEventListener("popstate", () => {
        this.loadForums(this.getPageFromUrl(), false);
      });
    },
    methods: {
      getPageFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const page = parseInt(params.get("page"), 10);

        if (isNaN(page) || page < 1) return 1;

        return page;
      },
      updateUrl(page) {
        const url = new URL(window.location.href);
        if (page <= 1) url.searchParams.delete("page");
        else url.searchParams.set("page", page);

        history.pushState({}, "", url);
      },
      loadForums(page = 1, updateHistory = true) {
        this.loading = true;
        if (updateHistory) this.updateUrl(page);
        fetch(`${window.apiRoot}forum/get-forums?page=${page}`)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
          })
          .then(result => {
            const data = result.ResponseObject;
            this.forums = data.Items;
            this.currentPage = data.CurrentPage;
            this.pageSize = data.PageSize;
            this.totalPage = data.TotalPage;
            this.totalCount = data.TotalCount;
            this.loading = false;
          })
          .catch(error => {
            this.loading = false;
          });
      },
      changePage(page) {
        if (page < 1 || page > this.totalPage) return;

        this.loadForums(page);
      },
      editForum(forum) {
        this.cancelReply();
        this.editingForumId = forum.ForumId;
        this.editTitle = forum.Title;
        this.editContent = forum.Text;
        this.editErrors = {};
        this.errorMessage = "";
      },
      cancelEdit() {
        this.editingForumId = null;
        this.editTitle = "";
        this.editContent = "";
        this.editErrors = {};
        this.errorMessage = "";
      },
      updateForum() {
        const options = {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            forumId: this.editingForumId,
            title: this.editTitle,
            content: this.editContent
          })
        };
        fetch(window.apiRoot + "forum/update-forum", options)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
          })
          .then(result => {
            if (result.Success) {
              this.cancelEdit();
              this.loadForums(this.currentPage);
              return;
            }

            this.editErrors = result.Errors || {};
            this.errorMessage = result.Message || "";
          })
          .catch(() => {
            this.errorMessage = "エラーが発生しました。";
          });
      },
      deleteForum(forumId) {
        this.errorMessage = "";
        if (!confirm("この投稿を削除しますか？")) return;
        fetch(window.apiRoot + "forum/delete-forum", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            forumId: forumId
          })
        })
        .then(response => {
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }

          return response.json();
        })
        .then(result => {
          if (result.Success) {
            this.loadForums(this.currentPage);
            return;
          }
          this.errorMessage = result.Message || "";
        })
        .catch(() => {
          this.errorMessage = "エラーが発生しました。";
        });
      },
      replyForum(forum) {
        this.cancelEdit();
        this.replyForumId = forum.ForumId;
        this.replyTitle = "Re: " + forum.Title;
        this.replyContent = "";
        this.replyErrors = {};
        this.errorMessage = "";
      },
      cancelReply() {
        this.replyForumId = null;
        this.replyTitle = "";
        this.replyContent = "";
        this.replyErrors = {};
        this.errorMessage = "";
      },
      postReply() {
        this.errorMessage = "";
        const options = {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            forumId: this.replyForumId,
            title: this.replyTitle,
            content: this.replyContent
          })
        };

        fetch(window.apiRoot + "forum/post-reply", options)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            return response.json();
          })
          .then(result => {
            if (result.Success) {
              this.cancelReply();
              this.loadForums(this.currentPage);
              return;
            }

            this.replyErrors = result.Errors || {};
            this.errorMessage = result.Message || "";
          })
          .catch(() => {
            this.errorMessage = "エラーが発生しました。";
          });
      },
    }
  });
  {% end_javascript %}
</script>
