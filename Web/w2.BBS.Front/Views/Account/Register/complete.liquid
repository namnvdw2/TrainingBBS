{% _layout 'layout.liquid' %}

{% _area title %}登録完了しました{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<vue-register-complete></vue-register-complete>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-register-complete">
  <div class="container">
    <div class="d-flex justify-content-center align-items-center vh-100">
      <div class="justify-content-center">
        <h4 class="text-center fw-bold mb-4">登録完了しました</h4>
        <p class="text-center">
          <a class="btn btn-primary w-20">トップページへ</a>
        </p>
      </div>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-register-complete', {
    template: '#vue-register-complete',
    data() {
      return {
      }
    },
    mounted() {
      this.autoRedirect();
    },
    methods: {
      autoRedirect: function () {
        setTimeout(() => {
          window.location.href = '{{ NextUrl }}';
        }, 3000);
      }
    }
  });
  {% end_javascript %}
</script>
