{% _layout 'layout.liquid' %}

{% _area title %}ログイン画面{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<vue-withdrawal-compele></vue-withdrawal-compele>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-withdrawal-compele">
  <div class="container">
    <div class="d-flex justify-content-center align-items-center vh-100">
      <div class="justify-content-center">
        <h4 class="text-center fw-bold mb-4">アカウント削除処理が完了しました</h4>
        <p class="text-center">
          <a class="btn btn-primary w-20" href="{{ RootUrl }}">トップへ</a>
        </p>
      </div>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-withdrawal-compele', {
    template: '#vue-withdrawal-compele',
    data() {
    },
    mounted() {
      this.autoRedirect();
    },
    methods: {
      autoRedirect: function () {
        setTimeout(() => {
          window.location.href = '{{ RootUrl }}';
        }, 3000);
      }
    }
  });
  {% end_javascript %}
</script>
