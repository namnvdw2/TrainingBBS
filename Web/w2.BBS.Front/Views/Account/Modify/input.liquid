{% _layout 'layout.liquid' %}

{% _area title %}ログイン画面{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
<vue-modify></vue-modify>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-modify">
  <div class="container">
    <div class="d-flex justify-content-center align-items-center vh-100">
      <div class="justify-content-center">
        <div class="align-items-center">
          <h3 class="text-center fw-bold mb-3">会員情報変更</h3>
          <h4 class="text-center fw-bold mb-5">変更したい情報を入力してください</h4>
          <form @submit.prevent="confirm" novalidate>
            <div class="row align-items-center mb-4">
              <label class="col-5 text-end col-form-label">新しいユーザー名：</label>
              <div class="col-7">
                <input :class="['form-control', { 'is-invalid': errors.name }]" type="text" v-model="name" placeholder="50字以内" />
                <div class="invalid-feedback">${ errors.name }</div>
              </div>
            </div>
            <div class="row align-items-center mb-4">
              <label class="col-5 text-end col-form-label">新しいログインID：</label>
              <div class="col-7">
                <input :class="['form-control', { 'is-invalid': errors.loginId }]" type="text" v-model="loginId" placeholder="15字以内" />
                <div class="invalid-feedback">${ errors.loginId }</div>
              </div>
            </div>
            <div class="row align-items-center mb-5">
              <label class="col-5 text-end col-form-label">新しいパスワード：</label>
              <div class="col-7">
                <input :class="['form-control', { 'is-invalid': errors.password }]" type="password" v-model="password" placeholder="15字以内" />
                <div class="invalid-feedback">${ errors.password }</div>
              </div>
            </div>
            <div class="text-center text-danger mb-3" v-if="errorMessage">${ errorMessage }</div>
            <div class="d-flex justify-content-center gap-2">
              <button type="submit" class="btn btn-primary px-4">確認する</button>
              <a class="btn btn-primary px-4" href="{{ RootUrl | append: 'login' }}">トップへ戻る</a>
            </div>
          </form>
        </div>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-modify', {
    template: '#vue-modify',
    data() {
      return {
        name: '{{ Name }}',
        loginId: '{{ LoginId }}',
        password: '',
        errors: {},
        errorMessage: '',
      }
    },
    mounted() {
    },
    methods: {
      confirm: function () {
        const options = {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            name: this.name,
            loginId: this.loginId,
            password: this.password
          }),
        }

        const promise = fetch(window.apiRoot + 'user/modify', options)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            return response.json();
          })
          .then(result => {
            if (result.Success) {
              window.location.href = result.RedirectUrl;
              return;
            }

            this.errors = result.Errors || {};
            this.errorMessage = result.Message || '';
          })
          .catch(error => {
            this.errorMessage = 'エラーが発生しました。時間をおいて再度お試しください。';
          });
      }
    }
  });
  {% end_javascript %}
</script>
