<header class="navbar navbar-expand-lg shadow-sm px-4">
  <div>
    <a class="navbar-brand" href="{{ RootUrl }}">掲示板課題</a>
  </div>

  {% if IsLogin %}
  <div class="ms-auto">
    <a class="btn btn-primary mx-1" href="{{ ModifyUrl }}">会員情報変更</a>
    <a class="btn btn-primary mx-1" href="{{ CancelUrl }}">会員退会</a>
    <a class="btn btn-primary mx-1" href="{{ LogoutUrl }}">ログアウト</a>
  </div>
  {% else %}
  <div class="ms-auto">
    <a class="btn btn-primary mx-1" href="{{ LoginUrl }}">ログイン</a>
  </div>
  {% endif %}
</header>
