<Account>
  <!--  Insert new user  -->
  <Insert>
    <Statement>
      <![CDATA[
        INSERT w2_User ( login_id, password, name, delete_flg, date_created, date_changed )
        VALUES ( @login_id, @password, @name, @delete_flg, GETDATE(), GETDATE() )
      ]]>
    </Statement>
    <Parameter>
      <Input Name="login_id" Type="nvarchar" Size="15"/>
      <Input Name="password" Type="nvarchar" Size="100"/>
      <Input Name="name" Type="nvarchar" Size="50"/>
      <Input Name="delete_flg" Type="nvarchar" Size="1"/>
    </Parameter>
  </Insert>

  <!--  Update existing user  -->
  <Update>
    <Statement>
      <![CDATA[
        UPDATE  w2_User
           SET  login_id = @login_id,
                password = @password,
                name = @name,
                date_changed = GETDATE()
         WHERE  user_id = @user_id
      ]]>
    </Statement>
    <Parameter>
      <Input Name="user_id" Type="int"/>
      <Input Name="login_id" Type="nvarchar" Size="15"/>
      <Input Name="password" Type="nvarchar" Size="100"/>
      <Input Name="name" Type="nvarchar" Size="50"/>
    </Parameter>
  </Update>
</Account>
